# Skopiuj do functions/.env (NIE publikuj tego pliku w Git).
# Adres odbiorcy powiadomień (może być Gmail):
NOTIFY_TO=kontakt.3dprintme@gmail.com
# Adres nadawcy musi być zweryfikowany w Resend (w DNS Twojej domeny):
EMAIL_FROM=3DPrintMe <formularz@3dprintme.pl>
# Lista hostów dopuszczonych przez Turnstile. Dla testów localhost dodaj go jawnie.
ALLOWED_HOSTNAMES=3dprintme.pl,www.3dprintme.pl
# CORS dla hostingu (tylko ten sam origin, bez nagłówka w zwykłej przeglądarce):
ALLOWED_ORIGINS=https://3dprintme.pl,https://www.3dprintme.pl
